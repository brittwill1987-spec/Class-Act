generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id              String   @id
  title           String
  companyOrBrand  String?
  category        String?
  status          String   @default("open")
  claimDeadline   String?
  eligibility     String?
  benefitAmount   String?
  howToFile       String?
  officialClaimUrl String?
  sourceUrl       String
  lastVerifiedUtc String?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  profile      Profile?
  applies      Application[]
  subscription Subscription?
  threads      ChatThread[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  fullName  String?
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caseId    String
  status    String   @default("applied")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([caseId])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])

  stripeCustomerId String?  @unique
  stripeSubId      String?  @unique

  status           String   @default("free")
  plan             String?
  currentPeriodEnd DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
}

model GrantOpportunity {
  id              String   @id
  title           String
  sponsor         String?
  eligibility     String?
  deadline        String?
  amount          String?
  officialUrl     String
  sourceUrl       String
  lastVerifiedUtc String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
